{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    // Resolve workspace packages to their TypeScript source, so the site and tests
    // use the packages as edited (no lib/ build step). Bun's bundler reads these too.
    "customConditions": ["bun"],
    "paths": {
      "htmx-ui": ["./packages/ui/src/index.ts"],
      "htmx-ui/theme": ["./packages/ui/src/theme.ts"]
    },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "exclude": ["node_modules", "dist", "**/lib", "site/archive", "packages/create-htmx-ui/template"]
}
