{
  "name": "htmx-ui-plugin-versions",
  "version": "0.1.0",
  "description": "Versioned docs for htmx-ui-engine sites: frozen snapshots of older releases served under /docs/v<id>, a version switcher, an old-version banner and CLI commands to name and archive versions.",
  "keywords": [
    "htmx",
    "htmx-ui",
    "htmx-ui-plugin",
    "docs",
    "versions",
    "versioning",
    "archive"
  ],
  "license": "MIT",
  "author": "Suson Waiba",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/susonwaiba/htmx-ui.git",
    "directory": "packages/plugin-versions"
  },
  "bugs": "https://github.com/susonwaiba/htmx-ui/issues",
  "homepage": "https://github.com/susonwaiba/htmx-ui#readme",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "bun": "./src/client.ts",
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.2.3"
  },
  "scripts": {
    "build": "bun run ../../scripts/build-plugin.ts",
    "prepublishOnly": "bun run --cwd ../.. release:check"
  },
  "peerDependencies": {
    "htmx-ui": "workspace:^",
    "htmx-ui-engine": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24",
    "htmx-ui": "workspace:*",
    "htmx-ui-engine": "workspace:*"
  }
}
